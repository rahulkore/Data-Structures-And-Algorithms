//https://leetcode.com/problems/domino-and-tromino-tiling

/**

*/

class Solution {
    public int numTilings(int n) {
        return helper(n);
    }


    /**
        Not very intuitive, only if you could visualize that when you take a domino and try the number of ways for n 
        It will yield as n-1 or n-2 basis how you can arrange the dominos

        But when you go with tromino, the arrangement is not that straight forward as you would have one box left out and 
        thus you need it in conjunction with another tromino and hence would get you n-3 and so on, and because you have 
        to keep it in pairs you have 2 different possible way to do it and hence from n-3 to n-0 you have 2 ways to do it all. 

        And hence the recurrence relation comes down to below 
        dp[n] = dp[n-1] + dp[n-2] + 2*(dp[n-3] + ... + dp[0]).  -> Equation 1
        Open dp[n-3] and you get the below 
        dp[n] = dp[n-1] + dp[n-2] + dp[n-3] + dp[n-3] + 2*(dp[n-4] + .. + dp[0])
        can be re written as 
        dp[n] = dp[n-1] + dp[n-3] + dp[n-2] + dp[n-3] + 2*(dp[n-4] + ... + dp[0]).  -> Equation 2

        From equation 1 , you can write the same relation for n-1 as follows

        dp[n-1] = dp[n-2] + dp[n-3] + 2*(dp[n-4] + ... + dp[0]).    -> Equation 3

        Substitute Equation 3 in 2 and you get the below
        dp[n] = dp[n-1] + dp[n-3] + dp[n-1]
        and hence, dp[n] = 2*dp[n-1] + dp[n-3]

        Solution inspired by https://leetcode.com/problems/domino-and-tromino-tiling/solutions/116581/detail-and-explanation-of-on-solution-wh-npb4 

     */
    /**
        TC : O(n), SC: O(n)
     */
    private int helper(int n) {
        int modulo = 1000000007;
        long dp[] = new long[1001];

        if(n==1) return 1;
        if(n==2) return 2;
        if(n==3) return 5;
        dp[1] = 1;
        dp[2] = 2;
        dp[3] = 5;

        for(int i=4;i<=n;i++) {
            dp[i] = 2*dp[i-1] + dp[i-3];
            dp[i] %= modulo;
        }

        return (int)dp[n];
    }
}
